# Copy to .env (or export these in your shell) to override the defaults.
# .env is gitignored - never commit real credentials.

# Database backend: auto | mysql | sqlite
# auto  -> try MySQL, fall back to SQLite so the project runs anywhere
FITBIT_DB_BACKEND=auto

FITBIT_DB_HOST=localhost
FITBIT_DB_PORT=3306
FITBIT_DB_USER=root
FITBIT_DB_PASSWORD=change-me
FITBIT_DB_NAME=guvi_db
